<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.OTPulse" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:statusBarColor">#F7F8FC</item>
        <item name="android:navigationBarColor">#F7F8FC</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>

    <style name="Theme.OTPulse.Starting" parent="Theme.OTPulse">
        <item name="android:windowBackground">@drawable/splash_background</item>
    </style>
</resources>
